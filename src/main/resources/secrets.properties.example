# Local-only example. Copy to secrets.properties and fill in your own values.
# NEVER commit secrets.properties. Environment variables are preferred for deployment.

# Gmail account used for OTP/reset emails.
MAIL_ID=your.sender@gmail.com
MAIL_PASS=your-16-char-google-app-password

# MongoDB Atlas connection string. Do not commit credentials.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=<app-name>


# YouTube Data API v3 key (YouTube project only)
YOUTUBE_API_KEY=replace-with-your-google-cloud-api-key
